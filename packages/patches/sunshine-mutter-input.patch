+      if (!created) {
+        BOOST_LOG(warning) << "mutter input: CreateSession failed: "sv << (error ? error->message : "unknown");
+        return false;
+      }
+
+      const gchar *path = nullptr;
+      g_variant_get(created, "(&o)", &path);
+      session_path_ = path ? path : "";
+
+      g_autoptr(GDBusProxy) session = g_dbus_proxy_new_sync(
+        connection_,
+        static_cast<GDBusProxyFlags>(G_DBUS_PROXY_FLAGS_NONE),
+        nullptr,
+        "org.gnome.Mutter.RemoteDesktop",
+        session_path_.c_str(),
+        "org.gnome.Mutter.RemoteDesktop.Session",
+        nullptr,
+        &error
+      );
+      if (!session) {
