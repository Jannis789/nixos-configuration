+
+    mutter_input_t() = default;
+
+    bool requested_locked() {
+      if (requested_checked_) {
+        return requested_;
+      }
+
+      requested_checked_ = true;
+      const char *value = g_getenv("SUNSHINE_GNOME_REMOTE_DESKTOP_INPUT");
+      requested_ = value && (g_strcmp0(value, "1") == 0 || g_ascii_strcasecmp(value, "true") == 0);
+      return requested_;
+    }
+
+    bool ensure_locked() {
+      if (state_ == state_e::active) {
+        return true;
+      }
+
+      const auto now = std::chrono::steady_clock::now();
+      if (state_ == state_e::unsupported && now - last_attempt_ < std::chrono::seconds {2}) {
+        return false;
+      }
+      last_attempt_ = now;
+      state_ = state_e::unsupported;
+
+      if (!requested_locked()) {
+        return false;
+      }
+
