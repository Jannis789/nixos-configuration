+      if (!connection_) {
+        connection_ = g_bus_get_sync(G_BUS_TYPE_SESSION, nullptr, &error);
+        if (!connection_) {
+          BOOST_LOG(warning) << "mutter input: no session bus: "sv << (error ? error->message : "unknown");
+          return false;
+        }
+      }
+
+      g_autoptr(GDBusProxy) remote_desktop = g_dbus_proxy_new_sync(
+        connection_,
+        static_cast<GDBusProxyFlags>(G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES | G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START),
+        nullptr,
+        "org.gnome.Mutter.RemoteDesktop",
+        "/org/gnome/Mutter/RemoteDesktop",
+        "org.gnome.Mutter.RemoteDesktop",
+        nullptr,
+        &error
+      );
+      if (!remote_desktop) {
+        BOOST_LOG(warning) << "mutter input: remote desktop proxy failed: "sv << (error ? error->message : "unknown");
+        return false;
+      }
+
+      g_autofree gchar *owner = g_dbus_proxy_get_name_owner(remote_desktop);
+      if (!owner) {
+        BOOST_LOG(info) << "mutter input: org.gnome.Mutter.RemoteDesktop not available"sv;
+        return false;
+      }
+
+      g_autoptr(GVariant) created = g_dbus_proxy_call_sync(
