+
+      static constexpr std::array letter_keys {
+        static_cast<std::uint32_t>(KEY_A), static_cast<std::uint32_t>(KEY_B),
+        static_cast<std::uint32_t>(KEY_C), static_cast<std::uint32_t>(KEY_D),
+        static_cast<std::uint32_t>(KEY_E), static_cast<std::uint32_t>(KEY_F),
+        static_cast<std::uint32_t>(KEY_G), static_cast<std::uint32_t>(KEY_H),
+        static_cast<std::uint32_t>(KEY_I), static_cast<std::uint32_t>(KEY_J),
+        static_cast<std::uint32_t>(KEY_K), static_cast<std::uint32_t>(KEY_L),
+        static_cast<std::uint32_t>(KEY_M), static_cast<std::uint32_t>(KEY_N),
+        static_cast<std::uint32_t>(KEY_O), static_cast<std::uint32_t>(KEY_P),
+        static_cast<std::uint32_t>(KEY_Q), static_cast<std::uint32_t>(KEY_R),
+        static_cast<std::uint32_t>(KEY_S), static_cast<std::uint32_t>(KEY_T),
+        static_cast<std::uint32_t>(KEY_U), static_cast<std::uint32_t>(KEY_V),
+        static_cast<std::uint32_t>(KEY_W), static_cast<std::uint32_t>(KEY_X),
+        static_cast<std::uint32_t>(KEY_Y), static_cast<std::uint32_t>(KEY_Z),
+      };
+      if (key_code >= 0x41 && key_code <= 0x5A) {
+        return letter_keys[key_code - 0x41];
+      }
+
+      static constexpr std::array digit_keys {
+        static_cast<std::uint32_t>(KEY_0), static_cast<std::uint32_t>(KEY_1),
+        static_cast<std::uint32_t>(KEY_2), static_cast<std::uint32_t>(KEY_3),
+        static_cast<std::uint32_t>(KEY_4), static_cast<std::uint32_t>(KEY_5),
+        static_cast<std::uint32_t>(KEY_6), static_cast<std::uint32_t>(KEY_7),
+        static_cast<std::uint32_t>(KEY_8), static_cast<std::uint32_t>(KEY_9),
+      };
