+        std::pair {0x23u, static_cast<std::uint32_t>(KEY_END)},
+        std::pair {0x24u, static_cast<std::uint32_t>(KEY_HOME)},
+        std::pair {0x25u, static_cast<std::uint32_t>(KEY_LEFT)},
+        std::pair {0x26u, static_cast<std::uint32_t>(KEY_UP)},
+        std::pair {0x27u, static_cast<std::uint32_t>(KEY_RIGHT)},
