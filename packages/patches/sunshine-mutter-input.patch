+    /**
+     * @brief Absolute positioning, translated into relative motion.
+     *
+     * mutter rejects NotifyPointerMotionAbsolute ("No screen cast active")
+     * unless the screen cast stream lives in this very RemoteDesktop session.
+     * Our stream is owned by the portal, so the absolute target is translated
+     * into relative motion against the position injected last.
+     */
+    void motion_absolute(const touch_port_t &touch_port, float x, float y) {
+      std::lock_guard lock {mutex_};
+      if (!ensure_locked()) {
+        return;
+      }
+
+      const int width = std::max(1, touch_port.width);
+      const int height = std::max(1, touch_port.height);
+      if (width != last_width_ || height != last_height_) {
+        last_width_ = width;
+        last_height_ = height;
+        have_last_ = false;
+      }
+
+      const double target_x = std::clamp(static_cast<double>(x), 0.0, static_cast<double>(width - 1));
+      const double target_y = std::clamp(static_cast<double>(y), 0.0, static_cast<double>(height - 1));
+      if (!have_last_) {
+        have_last_ = true;
+        last_x_ = target_x;
+        last_y_ = target_y;
+        return;
+      }
+
+      const double dx = target_x - last_x_;
+      const double dy = target_y - last_y_;
+      last_x_ = target_x;
+      last_y_ = target_y;
+      if (dx != 0.0 || dy != 0.0) {
+        send_locked("NotifyPointerMotionRelative", g_variant_new("(dd)", dx, dy));
+      }
+    }
