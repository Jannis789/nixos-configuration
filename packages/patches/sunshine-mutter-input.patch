+        std::pair {0x5Cu, static_cast<std::uint32_t>(KEY_RIGHTMETA)},
+        std::pair {0x6Au, static_cast<std::uint32_t>(KEY_KPASTERISK)},
+        std::pair {0x6Bu, static_cast<std::uint32_t>(KEY_KPPLUS)},
+        std::pair {0x6Du, static_cast<std::uint32_t>(KEY_KPMINUS)},
+        std::pair {0x6Eu, static_cast<std::uint32_t>(KEY_KPDOT)},
+        std::pair {0x6Fu, static_cast<std::uint32_t>(KEY_KPSLASH)},
+        std::pair {0x90u, static_cast<std::uint32_t>(KEY_NUMLOCK)},
+        std::pair {0x91u, static_cast<std::uint32_t>(KEY_SCROLLLOCK)},
+        std::pair {0xA1u, static_cast<std::uint32_t>(KEY_RIGHTSHIFT)},
+        std::pair {0xA3u, static_cast<std::uint32_t>(KEY_RIGHTCTRL)},
+        std::pair {0xA5u, static_cast<std::uint32_t>(KEY_RIGHTALT)},
+        std::pair {0xBAu, static_cast<std::uint32_t>(KEY_SEMICOLON)},
+        std::pair {0xBBu, static_cast<std::uint32_t>(KEY_EQUAL)},
+        std::pair {0xBCu, static_cast<std::uint32_t>(KEY_COMMA)},
+        std::pair {0xBDu, static_cast<std::uint32_t>(KEY_MINUS)},
+        std::pair {0xBEu, static_cast<std::uint32_t>(KEY_DOT)},
+        std::pair {0xBFu, static_cast<std::uint32_t>(KEY_SLASH)},
+        std::pair {0xC0u, static_cast<std::uint32_t>(KEY_GRAVE)},
+        std::pair {0xDBu, static_cast<std::uint32_t>(KEY_LEFTBRACE)},
+        std::pair {0xDCu, static_cast<std::uint32_t>(KEY_BACKSLASH)},
+        std::pair {0xDDu, static_cast<std::uint32_t>(KEY_RIGHTBRACE)},
+        std::pair {0xDEu, static_cast<std::uint32_t>(KEY_APOSTROPHE)},
+        std::pair {0xE2u, static_cast<std::uint32_t>(KEY_102ND)},
+      };
+      for (const auto &[vk, evdev] : special_keys) {
+        if (vk == key_code) {
