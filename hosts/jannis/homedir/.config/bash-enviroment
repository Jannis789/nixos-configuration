# 13_shell_bash.md
HISTSIZE=50000
HISTFILESIZE=100000
shopt -s histappend
shopt -s cdspell

# Secrets (18_secrets.md): API-Keys laden
if [ -f /run/secrets/api-keys ]; then
  set -a
  . /run/secrets/api-keys
  set +a
  unset API_SERVER_KEY 2>/dev/null
fi

export HERMES_HOME="/var/lib/hermes/.hermes"
